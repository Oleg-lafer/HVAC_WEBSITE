---
import UKOpportunityMap from "./UKOpportunityMap.astro";
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">UK commercial HVAC intelligence</div><h1>
        Your next project.<br />Already on<br /><em>our radar.</em>
      </h1><p>
        Find UK commercial HVAC projects worth pursuing. We research the
        opportunities, so you can focus on the right conversations.
      </p>
    </div><UKOpportunityMap /><div class="hero-actions">
      <div class="buttons">
        <a class="button button-primary" href="/sample-opportunity/"
          >View a sample opportunity <span aria-hidden="true">↗</span></a
        ><a class="button button-secondary" href="/#pilot"
          >Join the founding pilot <span aria-hidden="true">→</span></a>
      </div><p class="microcopy">
        Personally researched. Commercially relevant. Ready for your next step.
      </p>
    </div>
  </div>
</section><div class="container trust-strip">
  <span><b aria-hidden="true">⌖</b> Focused on UK commercial projects</span
  ><span><b aria-hidden="true">✓</b> Every opportunity personally reviewed</span
  ><span><b aria-hidden="true">↗</b> A clear next action, every time</span>
</div>
