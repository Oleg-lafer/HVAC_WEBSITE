---
import { site } from "../data/site.js";
---

<section class="section white" id="pilot">
  <div class="container pilot-grid">
    <div class="pilot-copy">
      <div class="eyebrow">A focused start</div><h2>
        Founding<br />Contractor Pilot.
      </h2><p>
        We’re onboarding a small number of UK commercial HVAC contractors. Put
        the intelligence to work for four weeks, then decide whether it earns a
        place in your business.
      </p>
    </div><div class="pilot-offer">
      <p class="pilot-price">{site.pilotPrice}</p><ul class="checks">
        <li>Three researched opportunities each week</li><li>
          Every opportunity personally reviewed
        </li><li>One deeper project investigation during the pilot</li><li>
          No long-term commitment
        </li><li>Continue only if useful</li>
      </ul><a class="button button-primary" href="/contact/"
        >Discuss the pilot <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
